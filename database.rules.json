{
  "rules": {
    "games": {
      "$gameId": {
        ".read": true,
        ".write": "data.child('moderatorId').val() === auth.uid",

        "teams": {
          ".write": "auth != null",
          "$teamId": {
            ".write": "data.child('uid').val() === auth.uid"
          }
        }
      }
    }
  }
}