{
  "rules": {
    "games": {
      "$gameId": {
        ".read": true,
        ".write": "(!data.exists() && auth.token.firebase.sign_in_provider === 'google.com') || (data.exists() && data.child('creatorId').val() === auth.uid)",
        "teams": {
          ".write": "auth != null",
          "$teamId": {
            ".write": "data.child('uid').val() === auth.uid"
          }
        },
        "witnesses": {
          "$witnessId": {
            ".write": "auth != null"
          }
        },
        "chats": {
          "$witnessId": {
            ".read": "auth != null",
            ".write": "auth != null"
          }
        },
        "results": {
          "$witnessId": {
            ".read": "auth != null",
            ".write": "auth != null"
          }
        }
      }
    }
  }
}
