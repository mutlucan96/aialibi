rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Match any file in the game-images directory
    match /game-images/{gameId}/{imageId} {
      // Anyone can read the images
      allow read: if true;
      // Disallow all client-side writes (only Cloud Functions via Admin SDK can upload)
      allow write: if false;
    }
  }
}
