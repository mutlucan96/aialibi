rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Witness portraits generated by Cloud Functions
    match /game-images/{gameId}/{imageId} {
      // Anyone can read generated witness portraits
      allow read: if true;
      // All writes are performed server-side via Firebase Admin SDK in Cloud Functions (which bypasses rules)
      allow write: if false;
    }

    // Disallow all other storage operations by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
